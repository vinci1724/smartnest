# ── PostgreSQL (TimescaleDB) ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=smartnest
POSTGRES_PASSWORD=smartnest_dev
POSTGRES_DB=smartnest
DATABASE_URL=postgresql://smartnest:smartnest_dev@localhost:5432/smartnest

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Kafka ──
KAFKA_BROKER=localhost:9092

# ── JWT Auth ──
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── App ──
PORT=3000
NODE_ENV=development
